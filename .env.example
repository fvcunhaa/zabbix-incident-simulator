# Zabbix 7.0+
ZABBIX_URL=http://zabbix-web/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=CHANGE_ME
ZABBIX_VERIFY_SSL=false

# LAB only. history.push requires the Zabbix frontend IP to be accepted by trapper items.
# For an isolated lab you can use 0.0.0.0/0. Restrict this in real environments.
ZABBIX_TRAPPER_ALLOWED_HOSTS=0.0.0.0/0

# Simulation
AUTO_START=true
EVENTS_PER_HOUR=20
ACK_MIN_MINUTES=3
ACK_MAX_MINUTES=25
RESOLUTION_MIN_MINUTES=30
RESOLUTION_MAX_MINUTES=180
MAX_ACTIVE_INCIDENTS=60
ONE_ACTIVE_INCIDENT_PER_HOST=true

# Inventory
CLIENT_COUNT=20
HOSTS_PER_CLIENT=10
HOST_GROUP=LAB - Incident Simulator

# API
HTTP_PORT=8080
API_KEY=change-me

# Persistence
SQLITE_PATH=/data/simulator.db
LOG_LEVEL=INFO
